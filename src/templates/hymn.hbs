<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{primaryTitle}}</title>
  <link rel="stylesheet" href="../assets/style.css">
</head>
<body>
  <div class="container">
    <a href="../index.html">← Back</a>

    <div class="hymn-header">
      <h1>{{primaryTitle}}</h1>
      <div class="translation-titles">
        {{#each translations}}
        <span class="lang-pill">{{lang}}: {{title}}</span>
        {{/each}}
      </div>
    </div>

    <div class="lang-toggles" id="langToggles">
      {{#each translations}}
      <button
        class="lang-toggle"
        data-lang="{{lang}}"
        aria-pressed="false"
      >{{lang}}</button>
      {{/each}}
    </div>

    <div class="body">
      {{#each sections}}
      <div class="section {{type}}">
        <div class="section-label">
          {{type}}{{#if number}} {{number}}{{/if}}
        </div>
        <div class="lines">
          {{#each rows}}
          <div class="line-group">
            {{#each translations}}
            <span class="line lang-{{lang}}" data-lang="{{lang}}">{{text}}</span>
            {{/each}}
            <hr class="line-divider">
          </div>
          {{/each}}
        </div>
      </div>
      {{/each}}
    </div>
  </div>

  <script>
    const primaryLang = "{{primaryLang}}";
    const firstTranslationLang = "{{firstTranslationLang}}";

    // Track which two are currently active (order matters — oldest first)
    const active = [primaryLang, firstTranslationLang].filter(Boolean);

    function applyVisibility() {
      document.querySelectorAll('.line').forEach(el => {
        el.classList.toggle('hidden', !active.includes(el.dataset.lang));
      });
      document.querySelectorAll('.lang-toggle').forEach(btn => {
        const on = active.includes(btn.dataset.lang);
        btn.classList.toggle('active', on);
        btn.setAttribute('aria-pressed', on);
      });
    }

    document.querySelectorAll('.lang-toggle').forEach(btn => {
      btn.addEventListener('click', () => {
        const lang = btn.dataset.lang;

        if (active.includes(lang)) {
          if (active.length === 2) active.splice(active.indexOf(lang), 1);
        } else {
          if (active.length === 2) active.shift();
          active.push(lang);
        }

        applyVisibility();
      });
    });

    applyVisibility();
  </script>
</body>
</html>